<?xml version="1.0" encoding="utf-8"?>
<!-- Circa: buttons stacked, full width, 52 dp pills; positive on top (see values/circa_dialogs.xml). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@*android:id/buttonPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            style="?android:attr/buttonBarStyle">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="?android:attr/dialogPreferredPadding"
        android:paddingEnd="?android:attr/dialogPreferredPadding"
        android:paddingTop="8px"
        android:paddingBottom="4px">

        <Button
            android:id="@*android:id/button1"
            style="?android:attr/buttonBarPositiveButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="76px"
            android:layout_marginTop="8px"
            android:gravity="center"
            android:background="@*android:drawable/btn_background_material_filled_tonal_watch" />

        <Button
            android:id="@*android:id/button3"
            style="?android:attr/buttonBarNeutralButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="76px"
            android:layout_marginTop="8px"
            android:gravity="center"
            android:background="@*android:drawable/btn_background_material_filled_tonal_watch" />

        <Button
            android:id="@*android:id/button2"
            style="?android:attr/buttonBarNegativeButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="76px"
            android:layout_marginTop="8px"
            android:gravity="center"
            android:background="@*android:drawable/btn_background_material_filled_tonal_watch" />

        <Space
            android:id="@*android:id/spacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
