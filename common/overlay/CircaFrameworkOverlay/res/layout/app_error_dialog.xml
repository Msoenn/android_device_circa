<?xml version="1.0" encoding="utf-8"?>
<!-- Circa: stacked pills inside the circle (see values/circa_dialogs.xml). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8px"
    android:paddingBottom="24px"
    android:paddingStart="44px"
    android:paddingEnd="44px">

    <Button
        android:id="@*android:id/aerr_restart"
        android:layout_marginTop="8px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@*android:string/aerr_restart"
        android:drawableStart="@*android:drawable/ic_refresh"
        style="@*android:style/aerr_list_item" />

    <Button
        android:id="@*android:id/aerr_app_info"
        android:layout_marginTop="8px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@*android:string/app_info"
        android:drawableStart="@*android:drawable/ic_info_outline_24"
        style="@*android:style/aerr_list_item" />

    <Button
        android:id="@*android:id/aerr_close"
        android:layout_marginTop="8px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@*android:string/aerr_close_app"
        android:drawableStart="@*android:drawable/ic_close"
        style="@*android:style/aerr_list_item" />

    <Button
        android:id="@*android:id/aerr_report"
        android:layout_marginTop="8px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@*android:string/aerr_report"
        android:drawableStart="@*android:drawable/ic_feedback"
        style="@*android:style/aerr_list_item" />

    <Button
        android:id="@*android:id/aerr_mute"
        android:layout_marginTop="8px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@*android:string/aerr_mute"
        android:drawableStart="@*android:drawable/ic_eject_24dp"
        style="@*android:style/aerr_list_item" />

</LinearLayout>
