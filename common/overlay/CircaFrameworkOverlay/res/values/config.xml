<?xml version="1.0" encoding="utf-8"?>
<!--
  Circa framework-res values for the 384x384 round watch panel.
-->
<resources>
    <!-- Round display. On the emulator hw.lcd.circular already makes the display round, so these are
         no-ops there; on the watch (no emulator property, resources 0) they give the framework the
         circle. px on purpose: independent of the density in use. -->
    <bool name="config_mainBuiltInDisplayIsRound">true</bool>
    <bool name="config_windowIsRound">true</bool>
    <dimen name="rounded_corner_radius">192px</dimen>
    <dimen name="rounded_corner_radius_top">192px</dimen>
    <dimen name="rounded_corner_radius_bottom">192px</dimen>
    <dimen name="rounded_corner_content_padding">32px</dimen>

    <!-- Always-on display: allowed on this panel, and on by default (Settings.Secure.DOZE_ALWAYS_ON
         defaults to config_dozeAlwaysOnEnabled). alwaysOnAvailable() also needs a non-empty
         config_dozeComponent; the launcher overlay (device/circa/apps) points that at the launcher's
         ambient dream, otherwise the GSI's SystemUI DozeService stays the doze component. -->
    <bool name="config_dozeAlwaysOnDisplayAvailable">true</bool>
    <bool name="config_dozeAlwaysOnEnabled">true</bool>

    <!-- Gestural navigation by default (edge swipe = back). -->
    <integer name="config_navBarInteractionMode">2</integer>

    <!-- Deep idle (battery). The watch has no significant-motion sensor, and with the AOSP default
         (true) DeviceIdleController refuses to run the deep-idle state machine without one
         (mMotionSensor=null -> scheduleAlarmLocked() returns early): deep idle never happens. Stock
         Wear OS ships false. With false the ladder runs INACTIVE -> IDLE_PENDING -> IDLE after
         screen-off and the AnyMotion accelerometer check is skipped. -->
    <bool name="config_autoPowerModeUseMotionSensor">false</bool>
    <!-- No location prefetch before deep idle (stock Wear: false; already off via aconfig here). -->
    <bool name="config_autoPowerModePrefetchLocation">false</bool>

    <!-- No PIN set: no keyguard at all (wake goes straight to the face). -->
    <bool name="config_disableLockscreenByDefault">true</bool>
</resources>
