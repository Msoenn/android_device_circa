<?xml version="1.0" encoding="utf-8"?>
<!-- Round pill key: a corner radius larger than half the key height makes SystemUI's 10dp rounded rect a
     stadium, like the stock Wear PIN pad. The fill is the theme's (NumPadAnimator recolours it). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?android:attr/colorControlNormal" />
    <corners android:radius="48dp" />
</shape>
