<?xml version="1.0" encoding="utf-8"?>
<!--
  The PIN bouncer (KeyguardPINView, layout/keyguard_pin_view) on the 384x384 round panel at density 192
  (1dp = 1.2px; ro.sf.lcd_density in common/circa.mk). The values below are the measured pixel geometry
  divided by 1.2: a 3x4 pad of ~88x71 px keys (drawn x1.09 by NumPadKey, circa_pin_key_scale) at a
  95 px column and 75 px row pitch (4 px row gap), the dots above it, everything inside the circle.
  Only values/ is overridden: at density 160 the panel is 384dp wide and values-sw360dp (key width
  84dp, column gap 20dp) wins over these, which is why this file was once tuned without effect.
-->
<resources>
    <!-- Width of the pin view (stock 420dp, wider than the panel); the keys centre in it. -->
    <dimen name="keyguard_security_width">256dp</dimen>
    <!-- Key width cap, gap between columns, row gap (also row0's bottom padding under the entry). -->
    <dimen name="num_pad_key_width">70dp</dimen>
    <dimen name="num_pad_key_margin_end">12dp</dimen>
    <dimen name="num_pad_entry_row_margin_bottom">8dp</dimen>
    <!-- width/height of a key: a pill instead of the phone's square key. -->
    <string name="num_pad_key_ratio">1.24</string>
    <!-- Entry field: a slim bar instead of the phone's 80dp block. -->
    <dimen name="keyguard_password_height">21.7dp</dimen>
    <dimen name="keyguard_pin_field_height">21.7dp</dimen>
    <!-- Vertical budget: no top gap, no bottom gap; the container's own top padding (status bar height +
         this, stock 20dp) trimmed so the keys get the height. -->
    <dimen name="keyguard_security_container_padding_top">12dp</dimen>
    <dimen name="keyguard_security_view_top_margin">0dp</dimen>
    <dimen name="keyguard_security_view_bottom_margin">0dp</dimen>
    <!-- Top margin of the bouncer message (stock 20dp). Negative: pulls the message up over the empty
         space above the pad, which gives the pad more room. -->
    <dimen name="keyguard_lock_padding">-15.8dp</dimen>
    <!-- Hide the secondary ("2 lines of detail") message row. -->
    <dimen name="secondary_message_padding">0dp</dimen>
    <integer name="bouncer_secondary_message_lines">0</integer>
    <!-- Emergency button + carrier text (keyguard_eca) cannot be removed by a value; it is pushed below
         the panel instead: 30dp top margin + 48dp button - 78dp bottom margin = 0 height, drawn off screen. -->
    <dimen name="keyguard_eca_top_margin">30dp</dimen>
    <dimen name="keyguard_eca_bottom_margin">-78dp</dimen>
</resources>
