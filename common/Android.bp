//
// Circa product layer: features declared from /product, init script.
//

prebuilt_etc {
    name: "circa-features.xml",
    src: "permissions/circa-features.xml",
    product_specific: true,
    sub_dir: "permissions",
}

prebuilt_etc {
    name: "init.circa.rc",
    src: "init/init.circa.rc",
    product_specific: true,
    sub_dir: "init",
}
