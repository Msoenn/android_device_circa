<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The always-on display is the launcher's ambient dream (a DreamService declared with
         BIND_DREAM_SERVICE), not SystemUI's DozeService. -->
    <string name="config_dozeComponent" translatable="false">org.pixelwatch.launcher/.AmbientDreamService</string>

    <!-- Buttons (Circa PhoneWindowManager policy, frameworks/base CircaKeyPolicy). A non-zero stem value is
         also what makes PhoneWindowManager install the stem key rule at all.
         Crown short press 3 = Circa: face on top -> app list (ALL_APPS to the HOME holder), else -> face.
         Crown long press 2 = power menu. Side button short press 100 = Circa (screen on, no PIN keyguard):
         toggles the notifications screen of the Circa shade; with a PIN keyguard showing it sleeps.
         Recents stays on the crown's app list, so the older "side button -> Recents" switch is off. -->
    <integer name="config_shortPressOnStemPrimaryBehavior">3</integer>
    <integer name="config_longPressOnStemPrimaryBehavior">2</integer>
    <integer name="config_shortPressOnPowerBehavior">100</integer>
    <bool name="config_circaPowerShortPressOpensRecents">false</bool>
    <!-- No setup wizard: let the platform deactivate FRP itself (see frameworks/base PersistentDataBlockService). -->
    <bool name="config_circaDisableFrp">true</bool>
    <!-- AOD battery: let the AP suspend while the display is in DOZE_SUSPEND (stock watches/phones with AOD set
         both). Without this PowerManager keeps "SuspendLockout" for the whole always-on period. -->
    <bool name="config_powerDecoupleAutoSuspendModeFromDisplay">true</bool>
    <bool name="config_powerDecoupleInteractiveModeFromDisplay">true</bool>

    <!-- Do Not Disturb access (quick settings tile) and the launcher's notification listener (the
         notification stream), granted by default instead of from the shell. -->
    <string name="config_defaultDndAccessPackages" translatable="false">org.pixelwatch.launcher</string>
    <string name="config_defaultListenerAccessPackages" translatable="false">org.pixelwatch.launcher</string>
</resources>
