<?xml version="1.0" encoding="utf-8"?>
<!-- Runtime permissions the Circa apps get at first boot (DefaultPermissionGrantPolicy, system apps only). -->
<exceptions>
    <exception package="org.pixelwatch.launcher">
        <!-- steps complication -->
        <permission name="android.permission.ACTIVITY_RECOGNITION" fixed="false" />
        <!-- Bluetooth quick setting -->
        <permission name="android.permission.BLUETOOTH_CONNECT" fixed="false" />
    </exception>
    <exception package="org.circa.settings">
        <!-- Bluetooth on/off (Connectivity) -->
        <permission name="android.permission.BLUETOOTH_CONNECT" fixed="false" />
    </exception>
    <exception package="org.pixelwatch.watchlink">
        <permission name="android.permission.BLUETOOTH_CONNECT" fixed="false" />
        <permission name="android.permission.BLUETOOTH_ADVERTISE" fixed="false" />
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false" />
        <permission name="android.permission.ACTIVITY_RECOGNITION" fixed="false" />
        <permission name="android.permission.health.READ_HEART_RATE" fixed="false" />
        <permission name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" fixed="false" />
    </exception>
</exceptions>
