<?xml version="1.0" encoding="utf-8"?>
<!-- Runtime permissions the Circa apps get at first boot (DefaultPermissionGrantPolicy, system apps only). -->
<exceptions>
    <exception package="org.circa.launcher">
        <!-- steps complication -->
        <permission name="android.permission.ACTIVITY_RECOGNITION" fixed="false" />
        <!-- Bluetooth quick setting -->
        <permission name="android.permission.BLUETOOTH_CONNECT" fixed="false" />
    </exception>
    <exception package="org.circa.clock">
        <!-- ringing / timer / stopwatch notifications and the full-screen alert -->
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false" />
    </exception>
    <exception package="org.circa.exercise">
        <!-- live heart rate (API 36: health.READ_HEART_RATE; BODY_SENSORS below 36) -->
        <permission name="android.permission.health.READ_HEART_RATE" fixed="false" />
        <permission name="android.permission.BODY_SENSORS" fixed="false" />
        <!-- steps / cadence -->
        <permission name="android.permission.ACTIVITY_RECOGNITION" fixed="false" />
        <!-- GPS distance, pace and route (fine needs coarse alongside); no background location -->
        <permission name="android.permission.ACCESS_FINE_LOCATION" fixed="false" />
        <permission name="android.permission.ACCESS_COARSE_LOCATION" fixed="false" />
        <!-- the ongoing-workout notification of the foreground service -->
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false" />
    </exception>
    <exception package="org.circa.settings">
        <!-- Bluetooth on/off (Connectivity) -->
        <permission name="android.permission.BLUETOOTH_CONNECT" fixed="false" />
        <!-- Bluetooth page: scan for devices to pair -->
        <permission name="android.permission.BLUETOOTH_SCAN" fixed="false" />
    </exception>
    <exception package="org.circa.watchlink">
        <permission name="android.permission.BLUETOOTH_CONNECT" fixed="false" />
        <permission name="android.permission.BLUETOOTH_ADVERTISE" fixed="false" />
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false" />
        <permission name="android.permission.ACTIVITY_RECOGNITION" fixed="false" />
        <permission name="android.permission.health.READ_HEART_RATE" fixed="false" />
        <permission name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" fixed="false" />
    </exception>
</exceptions>
