//
// Configuration for the Circa apps: the watch face/home launcher (org.pixelwatch.launcher) and the
// phone link (org.pixelwatch.watchlink). The APKs themselves are not in this public repo: they are
// prebuilt modules in the private, local-only vendor/circa-private (see README.md). Those modules list
// the modules below in `required`, so these are only installed together with the apps.
//

// Framework values that point at the launcher: AOD dream, crown short press, DND + notification listener.
runtime_resource_overlay {
    name: "CircaLauncherOverlay",
    manifest: "overlay/CircaLauncherOverlay/AndroidManifest.xml",
    resource_dirs: ["overlay/CircaLauncherOverlay/res"],
    product_specific: true,
    sdk_version: "current",
}

// Privileged permissions both priv-apps request (allowlist; the build fails on a missing entry).
prebuilt_etc {
    name: "privapp-permissions-circa.xml",
    src: "etc/privapp-permissions-circa.xml",
    product_specific: true,
    sub_dir: "permissions",
}

// Runtime permissions granted at first boot (no `pm grant` after install).
prebuilt_etc {
    name: "default-permissions-circa.xml",
    src: "etc/default-permissions-circa.xml",
    product_specific: true,
    sub_dir: "default-permissions",
}

// WatchLink stays out of doze/app standby restrictions (it keeps the BLE link to the phone).
prebuilt_etc {
    name: "sysconfig-circa.xml",
    src: "etc/sysconfig-circa.xml",
    product_specific: true,
    sub_dir: "sysconfig",
}
